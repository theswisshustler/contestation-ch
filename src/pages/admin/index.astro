---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SUPABASE_PUBLISHABLE_KEY, SUPABASE_URL } from '../../lib/blog.ts';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
const authOrigin = import.meta.env.DEV ? Astro.url.origin : (Astro.site || Astro.url.origin);
const adminUrl = new URL('/admin', authOrigin).toString();
const recoveryUrl = new URL('/admin?mode=recovery', authOrigin).toString();
---
<BaseLayout title="Administration des guides | Contestation.ch" description="Administration privée de la plateforme de publication." noindex={true}>
  <div id="blog-admin" data-supabase-url={SUPABASE_URL} data-supabase-key={SUPABASE_PUBLISHABLE_KEY} data-admin-url={adminUrl} data-recovery-url={recoveryUrl}>
    <section id="auth-panel" class="admin-auth">
      <p class="eyebrow">Accès privé</p>
      <h1>Administration des guides</h1>
      <p>Connectez-vous avec le compte autorisé dans <code>blog_admins</code>.</p>
      <form id="auth-form" class="admin-form admin-form--compact">
        <label>E-mail<input id="auth-email" type="email" autocomplete="email" required /></label>
        <label>Mot de passe<input id="auth-password" type="password" autocomplete="current-password" /></label>
        <div class="admin-actions"><button class="button button--secondary" type="submit">Se connecter</button><button id="magic-link" class="button button--ghost" type="button">Recevoir un lien magique</button></div>
        <button id="forgot-password" class="admin-text-button" type="button">Mot de passe oublié&nbsp;?</button>
      </form>
      <p id="auth-status" class="admin-status" aria-live="polite"></p>
    </section>

    <section id="recovery-panel" class="admin-auth" hidden>
      <p class="eyebrow">Compte administrateur</p>
      <h1>Choisissez un nouveau mot de passe</h1>
      <p>Votre lien a été validé par Supabase. Définissez maintenant le mot de passe qui servira à vos prochaines connexions.</p>
      <form id="recovery-form" class="admin-form admin-form--compact">
        <label>Nouveau mot de passe<input id="new-password" type="password" autocomplete="new-password" minlength="12" required aria-describedby="password-help" /></label>
        <small id="password-help" class="admin-help">12 caractères minimum. Utilisez une phrase unique que vous ne réutilisez pas ailleurs.</small>
        <label>Confirmez le mot de passe<input id="confirm-password" type="password" autocomplete="new-password" minlength="12" required /></label>
        <div class="admin-actions"><button id="save-password" class="button button--primary" type="submit">Enregistrer le nouveau mot de passe</button><button id="cancel-recovery" class="button button--ghost" type="button">Annuler</button></div>
      </form>
      <p id="recovery-status" class="admin-status" aria-live="polite"></p>
    </section>

    <section id="admin-panel" class="admin-shell" hidden>
      <header class="admin-topbar">
        <div><p class="eyebrow">Plateforme de publication</p><h1>Guides Contestation.ch</h1><p id="admin-identity"></p></div>
        <div class="admin-actions"><a class="button button--ghost" href="/admin/seo">Analyse SEO</a><a class="button button--ghost" href="/admin/articles">Voir tous les articles</a><button id="new-article" class="button button--primary">Nouvel article</button><button id="sign-out" class="button button--ghost">Déconnexion</button></div>
      </header>

      <div class="admin-layout">
        <aside class="admin-list-panel">
          <div class="admin-list-title">
            <div><p class="eyebrow">Bibliothèque</p><h2>Articles <span id="sidebar-count"></span></h2></div>
            <button id="refresh-list" class="sidebar-icon-button" type="button" aria-label="Actualiser la liste" title="Actualiser">↻</button>
          </div>
          <div class="sidebar-tools">
            <label class="sidebar-search">
              <span class="sr-only">Rechercher un article</span>
              <input id="sidebar-search" type="search" placeholder="Rechercher…" />
            </label>
            <div id="sidebar-filters" class="sidebar-filters" aria-label="Filtrer les articles">
              <button type="button" class="is-active" data-sidebar-status="all">Tous</button>
              <button type="button" data-sidebar-status="published">Publiés</button>
              <button type="button" data-sidebar-status="draft">Brouillons</button>
              <button type="button" data-sidebar-status="archived">Archivés</button>
            </div>
          </div>
          <div id="article-list" class="admin-list"></div>
          <a class="sidebar-all-link" href="/admin/articles">Gérer tous les articles <span>→</span></a>
        </aside>

        <main class="admin-editor">
          <details id="writing-assistant" class="admin-details writing-assistant" open>
            <summary>
              <span><span class="writing-assistant-icon" aria-hidden="true">✦</span> Assistant de rédaction IA</span>
              <small>Créer ou améliorer en 3 étapes</small>
            </summary>
            <div class="admin-details-content">
              <div class="assistant-steps" aria-label="Étapes de rédaction">
                <span class="is-active"><b>1</b> Objectif</span><span><b>2</b> Sources</span><span><b>3</b> Génération</span>
              </div>
              <p class="writing-assistant-intro">Un seul assistant pour créer un nouvel article ou améliorer celui qui est ouvert. Le résultat est automatiquement enregistré comme brouillon.</p>
              <div class="assistant-modes" role="radiogroup" aria-label="Type de rédaction">
                <label><input type="radio" name="assistant-mode" value="create" checked /><span><strong>Créer un article</strong><small>Partir d’un sujet et d’un brief</small></span></label>
                <label><input type="radio" name="assistant-mode" value="improve" /><span><strong>Améliorer l’article ouvert</strong><small>Réécrire et renforcer le brouillon actuel</small></span></label>
              </div>
              <section class="assistant-card" aria-labelledby="assistant-objective-title">
                <div class="assistant-card-heading">
                  <span class="assistant-card-number" aria-hidden="true">1</span>
                  <div><h3 id="assistant-objective-title">Cadrez votre article</h3><p>Donnez à l’IA une direction claire. Vous pourrez toujours ajuster le résultat.</p></div>
                </div>
                <div class="assistant-fields">
                  <label class="field field--wide"><span>Sujet ou titre de travail</span><input id="brief-title" maxlength="240" placeholder="Ex. Comment contester une hausse de loyer en Suisse" /></label>
                  <label class="field field--wide"><span>Consignes éditoriales</span><textarea id="brief-content" rows="5" maxlength="12000" placeholder="Public visé, problème à résoudre, points indispensables, ton, longueur et résultat attendu…"></textarea><small>Décrivez le résultat attendu avec vos propres mots.</small></label>
                  <label class="field"><span>Mots-clés principaux</span><input id="brief-keywords" placeholder="hausse de loyer, délai, formule officielle" /></label>
                  <label class="field"><span>Objectif de l’article</span><select id="brief-intent"><option value="guide">Guide pratique</option><option value="answer">Réponse à une question</option><option value="checklist">Checklist</option><option value="news">Mise à jour juridique</option></select></label>
                </div>
              </section>
              <div class="assistant-card assistant-card--compact">
                <label class="admin-check assistant-research"><input id="assistant-research" type="checkbox" checked /><span><strong>Recherche documentaire suisse</strong><small>Rechercher et intégrer des sources fiables et récentes.</small></span></label>
              </div>

              <fieldset class="link-builder assistant-card">
                <legend><span class="assistant-card-number" aria-hidden="true">2</span> Liens internes à intégrer</legend>
                <p>Sélectionnez les pages utiles. Les articles publiés sont proposés automatiquement.</p>
                <div id="internal-link-options" class="link-options">
                  <label><input type="checkbox" value="/" data-label="Vérifier mon loyer" checked /> Vérifier mon loyer</label>
                  <label><input type="checkbox" value="/diagnostic" data-label="Diagnostic de loyer" checked /> Diagnostic de loyer</label>
                  <label><input type="checkbox" value="/blog" data-label="Guides sur le droit du bail" /> Tous les guides</label>
                </div>
                <div id="article-link-options" class="article-link-options"></div>
              </fieldset>

              <fieldset class="link-builder assistant-card">
                <legend><span class="assistant-card-number" aria-hidden="true">3</span> Sources externes suisses</legend>
                <p>Ajoutez une source par ligne au format <strong>Libellé | https://…</strong>. Seuls les domaines suisses en <code>.ch</code> sont acceptés.</p>
                <textarea id="brief-sources" rows="4" placeholder="Office fédéral du logement | https://www.bwo.admin.ch/"></textarea>
                <div class="source-presets">
                  <button type="button" class="source-preset" data-label="Office fédéral du logement" data-url="https://www.bwo.admin.ch/">+ OFL</button>
                  <button type="button" class="source-preset" data-label="Portail des autorités suisses" data-url="https://www.ch.ch/fr/logement/location/">+ ch.ch</button>
                  <button type="button" class="source-preset" data-label="Recueil systématique du droit fédéral" data-url="https://www.fedlex.admin.ch/">+ Fedlex</button>
                </div>
                <p id="brief-source-error" class="admin-help is-error" hidden></p>
              </fieldset>

              <div class="admin-actions">
                <button id="prepare-draft" class="button button--primary" type="button">✦ Générer et enregistrer le brouillon</button>
                <button id="clear-brief" class="button button--ghost" type="button">Effacer le brief</button>
                <span id="assistant-status" class="admin-status" aria-live="polite"></span>
              </div>
            </div>
          </details>

          <form id="article-form" class="admin-form">
            <input id="article-id" type="hidden" />
            <input id="revision-id" type="hidden" />
            <input id="featured-media-id" type="hidden" />
            <div class="admin-section-heading"><div><p class="eyebrow">Contenu</p><h2 id="editor-title">Nouvel article</h2></div><span id="article-state" class="admin-badge">Brouillon</span></div>
            <label>Titre de l’article<input id="title" maxlength="240" required placeholder="Comment contester une hausse de loyer ?" /></label>
            <div class="admin-columns">
              <label>Slug <input id="slug" maxlength="90" placeholder="généré automatiquement" /></label>
              <label>Thèmes <input id="topics" placeholder="Hausse de loyer, Délais" /></label>
            </div>
            <label>Introduction / extrait<textarea id="excerpt" rows="3" maxlength="320" placeholder="Généré automatiquement si ce champ reste vide"></textarea></label>

            <div class="admin-source-bar">
              <label>Format d’entrée<select id="format"><option value="markdown">Markdown</option><option value="html">HTML</option><option value="rich-text">Rich Text</option><option value="plain">Texte simple</option><option value="canonical-v1">JSON canonique v1</option><option value="tiptap">JSON Tiptap</option><option value="json">JSON auto-détecté</option></select></label>
              <label class="button button--ghost admin-file-button">Importer un fichier<input id="import-file" type="file" accept=".md,.markdown,.html,.htm,.json,.txt" hidden /></label>
              <label class="button button--ghost admin-file-button">Ajouter une image<input id="image-file" type="file" accept="image/jpeg,image/png,image/webp,image/avif,image/gif" hidden /></label>
            </div>
            <label id="source-label">Contenu<textarea id="source-content" rows="22" required spellcheck="true" placeholder="Collez ou écrivez le contenu ici…"></textarea></label>
            <div id="rich-editor" class="rich-editor" contenteditable="true" hidden aria-label="Éditeur Rich Text"></div>

            <details class="admin-details">
              <summary>Design et thème de l’article</summary>
              <div class="admin-details-content">
                <div class="admin-columns">
                  <label>Style visuel<select id="article-theme"><option value="reference">Référence — clair et institutionnel</option><option value="editorial">Éditorial — lecture magazine</option><option value="compact">Pratique — dense et direct</option><option value="accessible">Accessible — texte agrandi</option></select></label>
                  <label>Couleur d’accent<input id="article-accent" type="color" value="#1b4965" /></label>
                </div>
                <div class="admin-columns">
                  <label>Présentation de l’image<select id="article-hero-style"><option value="rounded">Arrondie</option><option value="full">Pleine largeur</option><option value="hidden">Masquée</option></select></label>
                  <label class="admin-check"><input id="article-show-toc" type="checkbox" checked /> Afficher le sommaire</label>
                </div>
                <fieldset class="layout-controls">
                  <legend>Mise en page du contenu</legend>
                  <div class="layout-controls__grid">
                    <label>Espacement des puces <output id="article-list-gap-value">6 px</output><input id="article-list-gap" type="range" min="0" max="24" step="1" value="6" /></label>
                    <label>Espacement des paragraphes <output id="article-paragraph-gap-value">18 px</output><input id="article-paragraph-gap" type="range" min="8" max="32" step="1" value="18" /></label>
                    <label>Espacement des sections <output id="article-section-gap-value">44 px</output><input id="article-section-gap" type="range" min="24" max="72" step="2" value="44" /></label>
                    <label>Taille du texte <output id="article-font-size-value">17 px</output><input id="article-font-size" type="range" min="15" max="22" step="1" value="17" /></label>
                    <label>Largeur du contenu <output id="article-content-width-value">720 px</output><input id="article-content-width" type="range" min="600" max="900" step="10" value="720" /></label>
                  </div>
                </fieldset>
                <div class="theme-preview-stage">
                  <div class="theme-preview-toolbar">
                    <strong>Aperçu de l’article</strong>
                    <span id="theme-preview-width">Largeur de lecture : 720 px</span>
                  </div>
                  <div id="theme-preview" class="theme-preview" data-theme="reference" data-hero="rounded" data-toc="visible">
                    <header class="theme-preview__header">
                      <small>GUIDE PRATIQUE</small>
                      <h2>Comment préparer votre demande</h2>
                      <p>Les étapes essentielles pour constituer un dossier clair et complet.</p>
                    </header>
                    <div class="theme-preview__hero" aria-hidden="true"><span></span></div>
                    <div class="theme-preview__layout">
                      <div class="theme-preview__content">
                        <p>Avant de commencer, rassemblez les informations utiles concernant votre logement et votre bail.</p>
                        <p>Une demande bien documentée facilite son traitement et limite les échanges inutiles.</p>
                        <h3>Documents à préparer</h3>
                        <p>Munissez-vous notamment des éléments suivants :</p>
                        <ul>
                          <li>le contrat de bail actuel ;</li>
                          <li>les dernières notifications reçues ;</li>
                          <li>une copie de votre demande.</li>
                        </ul>
                        <h3>Étape suivante</h3>
                        <p>Vérifiez ensuite les délais applicables avant d’envoyer votre courrier.</p>
                      </div>
                      <aside class="theme-preview__toc"><strong>Sommaire</strong><span>Documents à préparer</span><span>Étape suivante</span></aside>
                    </div>
                  </div>
                </div>
              </div>
            </details>

            <details class="admin-details">
              <summary>SEO, auteur et vérification</summary>
              <div class="admin-details-content">
                <label>Titre SEO<input id="seo-title" maxlength="70" placeholder="Par défaut : titre de l’article" /></label>
                <label>Description SEO<textarea id="seo-description" rows="3" maxlength="180" placeholder="Par défaut : extrait"></textarea></label>
                <div class="admin-columns">
                  <label>Auteur<select id="author-id"><option value="">Contestation.ch</option></select></label>
                  <label>Relu par<select id="reviewer-id"><option value="">Non renseigné</option></select></label>
                </div>
                <div class="admin-columns">
                  <label>Date de vérification<input id="reviewed-at" type="date" /></label>
                  <label>Prochaine revue<input id="next-review-at" type="date" /></label>
                </div>
                <label>Sources officielles ou éditoriales <textarea id="sources" rows="4" placeholder="Une source par ligne : Libellé | https://…"></textarea></label>
              </div>
            </details>

            <p id="editor-status" class="admin-status" aria-live="polite"></p>
            <div class="admin-actions admin-actions--sticky">
              <button id="save-draft" class="button button--secondary" type="submit">Enregistrer le brouillon</button>
              <button id="preview" class="button button--ghost" type="button">Prévisualiser</button>
              <button id="publish" class="button button--primary" type="button">Publier</button>
              <button id="archive" class="button button--ghost" type="button">Archiver</button>
              <button id="delete" class="button button--danger" type="button">Supprimer</button>
            </div>
          </form>

          <details id="api-settings" class="admin-details admin-api" hidden>
            <summary>Intégrations API</summary>
            <div class="admin-details-content">
              <p>Les clés ne sont affichées qu’une seule fois. Conservez-les dans le gestionnaire de secrets de l’outil source.</p>
              <div class="admin-columns"><label>Nom de l’intégration<input id="api-key-name" placeholder="Outrank production" /></label><label>Permissions<select id="api-key-scope"><option value="import">Importer des brouillons</option><option value="publish">Importer et publier</option></select></label></div>
              <button id="create-api-key" class="button button--secondary" type="button">Créer une clé</button>
              <pre id="new-api-key" class="api-key-output" hidden></pre>
              <div id="api-key-list"></div>
            </div>
          </details>
        </main>
      </div>
    </section>
  </div>

  <script>
    // @ts-nocheck — interface DOM volontairement légère, contrats validés côté Edge Function.
    import { createClient } from '@supabase/supabase-js';

    const root = document.querySelector('#blog-admin');
    const supabaseUrl = root.dataset.supabaseUrl;
    const publishableKey = root.dataset.supabaseKey;
    const adminUrl = root.dataset.adminUrl;
    const recoveryUrl = root.dataset.recoveryUrl;
    const supabase = createClient(supabaseUrl, publishableKey);
    const $ = (selector) => document.querySelector(selector);
    const edgeUrl = (name) => import.meta.env.DEV ? `/api/admin/edge/${name}` : `${supabaseUrl}/functions/v1/${name}`;
    let session = null;
    let adminRole = null;
    let currentStatus = 'draft';
    let currentMetadata = {};
    let availableArticles = [];
    let sidebarStatus = 'all';
    let selectedArticleId = null;

    function status(message, error = false, target = '#editor-status') {
      const node = $(target); node.textContent = message || ''; node.classList.toggle('is-error', error);
    }

    function isEmailRateLimit(error) {
      return error?.code === 'over_email_send_rate_limit'
        || error?.code === 'over_request_rate_limit'
        || error?.status === 429
        || /email rate limit exceeded|too many requests/i.test(error?.message || '');
    }

    function authErrorMessage(error) {
      if (error?.code === 'over_email_send_rate_limit' || /email rate limit exceeded/i.test(error?.message || '')) {
        return 'Trop de liens ont été demandés en peu de temps. Supabase bloque temporairement les nouveaux envois pour protéger votre compte. Attendez au moins 60 secondes, puis réessayez. Vous pouvez aussi utiliser le dernier e-mail déjà reçu.';
      }
      if (error?.code === 'over_request_rate_limit' || error?.status === 429) {
        return 'Trop de demandes ont été effectuées. Attendez quelques minutes avant de réessayer.';
      }
      if (error?.code === 'invalid_credentials') return 'Adresse e-mail ou mot de passe incorrect.';
      if (error?.code === 'otp_expired') return 'Ce lien a expiré ou a déjà été utilisé. Demandez un nouveau lien.';
      if (error?.code === 'same_password') return 'Choisissez un mot de passe différent de votre mot de passe actuel.';
      if (error?.code === 'weak_password') return 'Ce mot de passe est trop faible. Utilisez au moins 12 caractères difficiles à deviner.';
      return error?.message || 'Une erreur d’authentification est survenue. Réessayez dans quelques instants.';
    }

    function startEmailCooldown(button, seconds = 60) {
      if (button._cooldownTimer) clearInterval(button._cooldownTimer);
      const originalLabel = button.dataset.originalLabel || button.textContent.trim();
      button.dataset.originalLabel = originalLabel;
      let remaining = seconds;
      button.disabled = true;
      button.textContent = `Réessayer dans ${remaining} s`;
      button._cooldownTimer = setInterval(() => {
        remaining -= 1;
        if (remaining <= 0) {
          clearInterval(button._cooldownTimer); button._cooldownTimer = null;
          button.disabled = false; button.textContent = originalLabel;
        } else button.textContent = `Réessayer dans ${remaining} s`;
      }, 1_000);
    }

    function showRecovery(message = '') {
      $('#auth-panel').hidden = true;
      $('#admin-panel').hidden = true;
      $('#recovery-panel').hidden = false;
      status(message, !!message, '#recovery-status');
      if (!message) $('#new-password').focus();
    }

    async function authHeaders() {
      const { data } = await supabase.auth.getSession();
      session = data.session;
      if (!session) throw new Error('Session expirée');
      return { 'Content-Type': 'application/json', apikey: publishableKey, Authorization: `Bearer ${session.access_token}` };
    }

    async function adminCall(action, payload = {}) {
      const response = await fetch(edgeUrl('blog-admin'), { method: 'POST', headers: await authHeaders(), body: JSON.stringify({ action, ...payload }) });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.error || `Erreur ${response.status}`);
      return body;
    }

    async function aiCall(payload) {
      const response = await fetch('/api/admin/blog-ai', {
        method: 'POST',
        headers: await authHeaders(),
        body: JSON.stringify(payload),
      });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.error || `Erreur ${response.status}`);
      return body;
    }

    async function ingest(payload) {
      const response = await fetch(edgeUrl('blog-ingest'), {
        method: 'POST',
        headers: await authHeaders(),
        body: JSON.stringify({ ...payload, idempotencyKey: crypto.randomUUID() }),
      });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.error || `Erreur ${response.status}`);
      return body;
    }

    function sourceValue() {
      return $('#format').value === 'rich-text' ? $('#rich-editor').innerHTML : $('#source-content').value;
    }

    function parseSources() {
      return $('#sources').value.split('\n').map((line) => {
        const [label, url] = line.split('|').map((part) => part?.trim());
        return label && /^https?:\/\//.test(url || '') ? { label, url } : null;
      }).filter(Boolean);
    }

    function metadata() {
      return {
        title: $('#title').value.trim(), slug: $('#slug').value.trim() || undefined,
        excerpt: $('#excerpt').value.trim() || undefined,
        seoTitle: $('#seo-title').value.trim() || undefined,
        seoDescription: $('#seo-description').value.trim() || undefined,
        locale: 'fr-CH', topics: $('#topics').value.split(',').map((item) => item.trim()).filter(Boolean),
        featuredMediaId: $('#featured-media-id').value || undefined,
        authorId: $('#author-id').value || undefined,
        reviewedById: $('#reviewer-id').value || undefined,
        reviewedAt: $('#reviewed-at').value ? `${$('#reviewed-at').value}T12:00:00+02:00` : undefined,
        nextReviewAt: $('#next-review-at').value || undefined,
        sources: parseSources(),
        extra: {
          ...currentMetadata,
          theme: {
            preset: $('#article-theme').value,
            accent: $('#article-accent').value,
            heroStyle: $('#article-hero-style').value,
            showToc: $('#article-show-toc').checked,
            layout: {
              listGap: Number($('#article-list-gap').value),
              paragraphGap: Number($('#article-paragraph-gap').value),
              sectionGap: Number($('#article-section-gap').value),
              fontSize: Number($('#article-font-size').value),
              contentWidth: Number($('#article-content-width').value),
            },
          },
        },
      };
    }

    function layoutValue(value, min, max, fallback) {
      const parsed = Number(value);
      return Number.isFinite(parsed) ? Math.min(max, Math.max(min, parsed)) : fallback;
    }

    function updateThemePreview() {
      const preview = $('#theme-preview');
      preview.dataset.theme = $('#article-theme').value;
      preview.dataset.hero = $('#article-hero-style').value;
      preview.dataset.toc = $('#article-show-toc').checked ? 'visible' : 'hidden';
      preview.style.setProperty('--preview-accent', $('#article-accent').value);
      const controls = [
        ['article-list-gap', 'article-list-gap-value', '--preview-list-gap'],
        ['article-paragraph-gap', 'article-paragraph-gap-value', '--preview-paragraph-gap'],
        ['article-section-gap', 'article-section-gap-value', '--preview-section-gap'],
        ['article-font-size', 'article-font-size-value', '--preview-font-size'],
        ['article-content-width', 'article-content-width-value', '--preview-content-width'],
      ];
      controls.forEach(([inputId, outputId, property]) => {
        const value = Number($(`#${inputId}`).value);
        $(`#${outputId}`).textContent = `${value} px`;
        preview.style.setProperty(property, `${value}px`);
      });
      $('#theme-preview-width').textContent = `Largeur de lecture : ${$('#article-content-width').value} px`;
    }

    function updateFormat() {
      const rich = $('#format').value === 'rich-text';
      $('#source-label').hidden = rich;
      $('#rich-editor').hidden = !rich;
      if (rich && !$('#rich-editor').innerHTML.trim() && $('#source-content').value.trim()) $('#rich-editor').textContent = $('#source-content').value;
    }

    function resetEditor() {
      $('#article-form').reset(); $('#article-id').value = ''; $('#revision-id').value = ''; $('#featured-media-id').value = '';
      $('#source-content').value = ''; $('#rich-editor').innerHTML = ''; $('#editor-title').textContent = 'Nouvel article';
      selectedArticleId = null;
      if (availableArticles.length) renderSidebar();
      currentMetadata = {}; currentStatus = 'draft'; $('#article-state').textContent = 'Brouillon'; status(''); updateFormat(); updateThemePreview();
    }

    const sidebarStatusLabel = (value) => value === 'published' ? 'Publié' : value === 'archived' ? 'Archivé' : 'Brouillon';

    function articleSidebarItem(article) {
      const content = article.draft || article.published || {};
      const item = document.createElement('article');
      item.className = `admin-list-item admin-list-item--${article.status}`;
      item.dataset.articleId = article.id;
      item.classList.toggle('is-selected', article.id === selectedArticleId);
      item.innerHTML = `
        <button class="article-open" type="button">
          <span class="article-item-top"><span class="sidebar-badge"></span><time></time></span>
          <strong></strong><span class="article-item-excerpt"></span>
        </button>
        <div class="article-quick-actions">
          <button type="button" data-action="preview" title="Prévisualiser">Aperçu</button>
          <button type="button" data-action="publish">Publier</button>
          <button type="button" data-action="archive">Archiver</button>
          <button type="button" data-action="delete" class="quick-delete">Supprimer</button>
        </div>`;
      item.querySelector('.sidebar-badge').textContent = sidebarStatusLabel(article.status);
      item.querySelector('time').textContent = article.updated_at
        ? new Intl.DateTimeFormat('fr-CH', { day: '2-digit', month: 'short' }).format(new Date(article.updated_at))
        : '';
      item.querySelector('strong').textContent = content.title || 'Sans titre';
      item.querySelector('.article-item-excerpt').textContent = content.excerpt || `/${article.current_slug || content.slug || ''}`;
      item.querySelector('.article-open').addEventListener('click', () => loadArticle(article.id));
      item.querySelector('[data-action="publish"]').hidden = article.status === 'published' || adminRole === 'editor';
      item.querySelector('[data-action="archive"]').hidden = article.status === 'archived' || adminRole === 'editor';
      item.querySelector('[data-action="delete"]').hidden = adminRole !== 'owner';
      item.querySelectorAll('[data-action]').forEach((button) => button.addEventListener('click', () => quickArticleAction(button.dataset.action, article)));
      return item;
    }

    function renderSidebar() {
      const query = $('#sidebar-search').value.trim().toLocaleLowerCase('fr');
      const filtered = availableArticles.filter((article) => {
        const content = article.draft || article.published || {};
        const searchable = `${content.title || ''} ${content.excerpt || ''} ${article.current_slug || ''}`.toLocaleLowerCase('fr');
        return (sidebarStatus === 'all' || article.status === sidebarStatus) && (!query || searchable.includes(query));
      });
      $('#sidebar-count').textContent = `(${filtered.length})`;
      $('#article-list').replaceChildren(...filtered.map(articleSidebarItem));
      if (!filtered.length) $('#article-list').innerHTML = '<div class="sidebar-empty"><strong>Aucun article</strong><span>Modifiez la recherche ou le filtre.</span></div>';
    }

    async function refreshList() {
      const list = $('#article-list'); list.innerHTML = '<div class="sidebar-loading">Actualisation…</div>';
      $('#refresh-list').classList.add('is-loading');
      try {
        const data = await adminCall('list');
        availableArticles = (data.articles || []).filter((article) => !article.deleted_at);
        renderSidebar();
        renderArticleLinkOptions();
      }
      catch (error) { list.innerHTML = `<p class="is-error"></p>`; list.firstChild.textContent = error.message; }
      finally { $('#refresh-list').classList.remove('is-loading'); }
    }

    async function quickArticleAction(action, article) {
      try {
        if (action === 'preview') {
          if (article.status === 'published' && article.current_slug) {
            window.open(`/blog/${encodeURIComponent(article.current_slug)}`, '_blank', 'noopener');
          } else {
            const revisionId = article.draft_revision_id || article.published_revision_id;
            const preview = await adminCall('preview', { revisionId });
            window.open(`/blog/apercu?token=${encodeURIComponent(preview.token)}`, '_blank', 'noopener');
          }
          return;
        }
        if (action === 'publish') {
          if (!confirm(`Publier « ${(article.draft || article.published)?.title || 'cet article'} » ?`)) return;
          await adminCall('publish', { articleId: article.id });
          status('Article publié.');
        }
        if (action === 'archive') {
          if (!confirm(`Archiver « ${(article.draft || article.published)?.title || 'cet article'} » ?`)) return;
          await adminCall('archive', { articleId: article.id });
          status('Article archivé.');
        }
        if (action === 'delete') {
          if (!confirm(`Supprimer définitivement « ${(article.draft || article.published)?.title || 'cet article'} » et toutes ses révisions ?`)) return;
          await adminCall('delete', { articleId: article.id });
          if ($('#article-id').value === article.id) resetEditor();
          status('Article supprimé définitivement.');
        }
        await refreshList();
      } catch (error) { status(error.message, true); }
    }

    function renderArticleLinkOptions() {
      const container = $('#article-link-options');
      if (!container) return;
      const published = availableArticles.filter((article) => article.status === 'published' && article.current_slug);
      if (!published.length) {
        container.innerHTML = '<p class="admin-help">Aucun article publié disponible pour le maillage.</p>';
        return;
      }
      container.replaceChildren(...published.slice(0, 12).map((article) => {
        const revision = article.published || article.draft || {};
        const label = document.createElement('label');
        const input = document.createElement('input');
        input.type = 'checkbox'; input.value = `/blog/${article.current_slug}`; input.dataset.label = revision.title || article.current_slug;
        label.append(input, document.createTextNode(` ${revision.title || article.current_slug}`));
        return label;
      }));
    }

    function parseSwissSources() {
      const errorNode = $('#brief-source-error');
      const lines = $('#brief-sources').value.split('\n').map((line) => line.trim()).filter(Boolean);
      const sources = [];
      const invalid = [];
      for (const line of lines) {
        const separator = line.indexOf('|');
        const label = separator >= 0 ? line.slice(0, separator).trim() : '';
        const rawUrl = separator >= 0 ? line.slice(separator + 1).trim() : '';
        try {
          const url = new URL(rawUrl);
          const swissHost = url.hostname === 'ch.ch' || url.hostname.endsWith('.ch');
          if (!label || url.protocol !== 'https:' || !swissHost) throw new Error();
          sources.push({ label, url: url.toString() });
        } catch (_) { invalid.push(line); }
      }
      errorNode.hidden = invalid.length === 0;
      errorNode.textContent = invalid.length ? `Source refusée : ${invalid[0]}. Utilisez une URL HTTPS sur un domaine suisse en .ch.` : '';
      return invalid.length ? null : sources;
    }

    function selectedInternalLinks() {
      return [...document.querySelectorAll('#internal-link-options input:checked, #article-link-options input:checked')]
        .map((input) => ({ label: input.dataset.label, url: input.value }));
    }

    async function prepareDraft() {
      const title = $('#brief-title').value.trim();
      const brief = $('#brief-content').value.trim();
      const mode = document.querySelector('input[name="assistant-mode"]:checked').value;
      const existingContent = sourceValue().trim();
      if (mode === 'create' && (!title || !brief)) {
        status('Ajoutez un sujet et des consignes avant de générer le brouillon.', true, '#assistant-status');
        $('#writing-assistant').open = true;
        (!title ? $('#brief-title') : $('#brief-content')).focus();
        return;
      }
      if (mode === 'improve' && !existingContent) {
        status('Ouvrez ou rédigez d’abord un article à améliorer.', true, '#assistant-status');
        return;
      }
      const sources = parseSwissSources();
      if (!sources) return;
      const keywords = $('#brief-keywords').value.split(',').map((item) => item.trim()).filter(Boolean);
      const links = selectedInternalLinks();
      const button = $('#prepare-draft');
      button.disabled = true;
      button.textContent = mode === 'improve' ? 'Amélioration en cours…' : 'Rédaction en cours…';
      status('Analyse du brief et recherche des sources… Cette étape peut prendre jusqu’à une minute.', false, '#assistant-status');
      try {
        const instruction = [
          title ? `Sujet : ${title}` : '',
          brief,
          `Format éditorial : ${$('#brief-intent').selectedOptions[0].textContent}.`,
          keywords.length ? `Mots-clés à intégrer naturellement : ${keywords.join(', ')}.` : '',
          links.length ? `Liens internes pertinents à intégrer : ${links.map((link) => `${link.label} (${link.url})`).join(', ')}.` : '',
        ].filter(Boolean).join('\n');
        const data = await aiCall({
          brief: instruction,
          existingContent: mode === 'improve' ? existingContent : '',
          mode,
          research: $('#assistant-research').checked,
          sourceUrls: sources.map((source) => source.url),
        });
        if (mode === 'create') resetEditor();
        const article = data.article;
        $('#title').value = article.title;
        $('#excerpt').value = article.excerpt;
        $('#seo-title').value = article.seoTitle;
        $('#seo-description').value = article.seoDescription;
        $('#topics').value = article.topics.join(', ');
        $('#format').value = 'markdown';
        $('#source-content').value = article.markdown;
        const mergedSources = [...parseSources(), ...sources, ...(article.sources || [])];
        const uniqueSources = [...new Map(mergedSources.map((source) => [source.url, source])).values()];
        $('#sources').value = uniqueSources.map((source) => `${source.label} | ${source.url}`).join('\n');
        updateFormat();
        const saved = await saveDraft();
        await loadArticle(saved.articleId);
        $('#writing-assistant').open = false;
        status(`Brouillon ${mode === 'improve' ? 'amélioré' : 'créé'} avec ${data.model} et enregistré. Vérifiez les faits et les sources avant publication.`);
        $('#article-form').scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (error) {
        status(error.message, true, '#assistant-status');
      } finally {
        button.disabled = false;
        button.textContent = '✦ Générer et enregistrer le brouillon';
      }
    }

    function addSourcePreset(button) {
      const line = `${button.dataset.label} | ${button.dataset.url}`;
      const current = $('#brief-sources').value.split('\n').map((item) => item.trim()).filter(Boolean);
      if (!current.includes(line)) $('#brief-sources').value = [...current, line].join('\n');
      parseSwissSources();
    }

    async function loadAuthors() {
      const data = await adminCall('authors');
      for (const select of [$('#author-id'), $('#reviewer-id')]) {
        const first = select.firstElementChild; select.replaceChildren(first, ...data.authors.map((author) => new Option(author.name, author.id)));
      }
    }

    async function loadArticle(id) {
      status('Chargement…');
      try {
        const data = await adminCall('get', { articleId: id }); const revision = data.revisions[0];
        if (!revision) throw new Error('Aucune révision disponible');
        $('#article-id').value = id; $('#revision-id').value = data.article.draft_revision_id || revision.id;
        $('#title').value = revision.title; $('#slug').value = revision.slug; $('#excerpt').value = revision.excerpt;
        $('#seo-title').value = revision.seo_title; $('#seo-description').value = revision.seo_description;
        $('#topics').value = data.topics.map((topic) => topic?.name).filter(Boolean).join(', ');
        $('#featured-media-id').value = revision.featured_media_id || ''; $('#author-id').value = revision.author_id || '';
        $('#reviewer-id').value = revision.reviewed_by_id || ''; $('#reviewed-at').value = revision.reviewed_at?.slice(0, 10) || '';
        $('#next-review-at').value = revision.next_review_at || '';
        $('#sources').value = (revision.sources || []).map((source) => `${source.label} | ${source.url}`).join('\n');
        currentMetadata = revision.metadata && typeof revision.metadata === 'object' ? revision.metadata : {};
        const theme = revision.metadata?.theme || {};
        $('#article-theme').value = ['reference', 'editorial', 'compact', 'accessible'].includes(theme.preset) ? theme.preset : 'reference';
        $('#article-accent').value = /^#[0-9a-f]{6}$/i.test(theme.accent || '') ? theme.accent : '#1b4965';
        $('#article-hero-style').value = ['rounded', 'full', 'hidden'].includes(theme.heroStyle) ? theme.heroStyle : 'rounded';
        $('#article-show-toc').checked = theme.showToc !== false;
        const layout = theme.layout && typeof theme.layout === 'object' ? theme.layout : {};
        $('#article-list-gap').value = layoutValue(layout.listGap, 0, 24, 6);
        $('#article-paragraph-gap').value = layoutValue(layout.paragraphGap, 8, 32, 18);
        $('#article-section-gap').value = layoutValue(layout.sectionGap, 24, 72, 44);
        $('#article-font-size').value = layoutValue(layout.fontSize, 15, 22, 17);
        $('#article-content-width').value = layoutValue(layout.contentWidth, 600, 900, 720);
        $('#format').value = revision.source_format || 'canonical-v1';
        const source = revision.source_content || JSON.stringify(revision.document, null, 2);
        $('#source-content').value = source; $('#rich-editor').innerHTML = $('#format').value === 'rich-text' ? source : '';
        selectedArticleId = id; renderSidebar();
        currentStatus = data.article.status; $('#article-state').textContent = currentStatus === 'published' ? 'Publié' : currentStatus === 'archived' ? 'Archivé' : 'Brouillon';
        $('#editor-title').textContent = revision.title; updateFormat(); updateThemePreview(); status('Article chargé.');
      } catch (error) { status(error.message, true); }
    }

    async function saveDraft(event) {
      event?.preventDefault(); status('Normalisation et enregistrement…');
      try {
        const body = await ingest({ articleId: $('#article-id').value || undefined, format: $('#format').value, content: sourceValue(), metadata: metadata(), intent: 'draft', source: { provider: 'admin' } });
        $('#article-id').value = body.articleId; $('#revision-id').value = body.revisionId; $('#slug').value = body.slug;
        $('#editor-title').textContent = $('#title').value; status(body.warnings?.length ? `Brouillon enregistré. ${body.warnings.join(' ')}` : 'Brouillon enregistré.');
        await refreshList(); return body;
      } catch (error) { status(error.message, true); throw error; }
    }

    async function publishArticle() {
      try { const draft = await saveDraft(); status('Publication…'); const result = await adminCall('publish', { articleId: draft.articleId }); currentStatus = 'published'; $('#article-state').textContent = 'Publié'; status(`Article publié : /blog/${result.slug}`); await refreshList(); }
      catch (_) { /* saveDraft a déjà affiché l'erreur */ }
    }

    async function previewArticle() {
      try { const draft = await saveDraft(); const preview = await adminCall('preview', { revisionId: draft.revisionId }); window.open(`/blog/apercu?token=${encodeURIComponent(preview.token)}`, '_blank', 'noopener'); }
      catch (_) { /* message déjà visible */ }
    }

    async function archiveArticle() {
      const id = $('#article-id').value; if (!id || !confirm('Archiver cet article ?')) return;
      try { await adminCall('archive', { articleId: id }); currentStatus = 'archived'; $('#article-state').textContent = 'Archivé'; status('Article archivé.'); await refreshList(); } catch (error) { status(error.message, true); }
    }

    async function deleteArticle() {
      const id = $('#article-id').value; if (!id || !confirm('Supprimer cet article ? Un article déjà publié sera retiré et son URL renverra 410.')) return;
      try { await adminCall('delete', { articleId: id }); resetEditor(); status('Article supprimé.'); await refreshList(); } catch (error) { status(error.message, true); }
    }

    async function importFile(file) {
      const ext = file.name.split('.').pop().toLowerCase(); const map = { md: 'markdown', markdown: 'markdown', html: 'html', htm: 'html', json: 'json', txt: 'plain' };
      $('#format').value = map[ext] || 'plain'; $('#source-content').value = await file.text(); updateFormat(); status(`Fichier ${file.name} importé dans l’éditeur.`);
    }

    async function uploadImage(file) {
      status('Préparation de l’image…');
      try {
        const signed = await adminCall('media-upload-url', { mime: file.type, bytes: file.size });
        const upload = await supabase.storage.from('blog-media').uploadToSignedUrl(signed.path, signed.token, file, { contentType: file.type });
        if (upload.error) throw upload.error;
        const alt = prompt('Texte alternatif décrivant l’image :', '') || '';
        const registered = await adminCall('media-register', { path: signed.path, publicUrl: signed.publicUrl, mime: file.type, bytes: file.size, alt });
        $('#featured-media-id').value ||= registered.media.id;
        const insertion = `\n\n![${alt}](${signed.publicUrl})\n\n`;
        if ($('#format').value === 'markdown') $('#source-content').setRangeText(insertion, $('#source-content').selectionStart, $('#source-content').selectionEnd, 'end');
        else { $('#format').value = 'html'; $('#source-content').value += `\n<figure><img src="${signed.publicUrl}" alt="${alt.replace(/"/g, '&quot;')}"></figure>`; updateFormat(); }
        status('Image ajoutée.');
      } catch (error) { status(error.message, true); }
    }

    async function refreshApiKeys() {
      if (adminRole !== 'owner') return;
      const data = await adminCall('list-api-keys'); const list = $('#api-key-list'); list.innerHTML = '';
      data.keys.forEach((key) => { const row = document.createElement('div'); row.className = 'api-key-row'; row.innerHTML = '<span></span><button type="button">Révoquer</button>'; row.querySelector('span').textContent = `${key.name} · ${key.key_prefix}… · ${key.active ? 'active' : 'révoquée'}`; row.querySelector('button').disabled = !key.active; row.querySelector('button').onclick = async () => { await adminCall('revoke-api-key', { id: key.id }); refreshApiKeys(); }; list.append(row); });
    }

    async function createApiKey() {
      try { const publish = $('#api-key-scope').value === 'publish'; const data = await adminCall('create-api-key', { name: $('#api-key-name').value || 'Intégration API', scopes: publish ? ['articles:import', 'articles:write', 'articles:publish'] : ['articles:import', 'articles:write'] }); const output = $('#new-api-key'); output.textContent = data.apiKey; output.hidden = false; await refreshApiKeys(); }
      catch (error) { status(error.message, true); }
    }

    async function enterAdmin() {
      try {
        const me = await adminCall('me'); adminRole = me.role; $('#auth-panel').hidden = true; $('#admin-panel').hidden = false;
        $('#admin-identity').textContent = `Connecté · rôle ${adminRole}`;
        $('#api-settings').hidden = adminRole !== 'owner';
        $('#publish').hidden = adminRole === 'editor';
        $('#archive').hidden = adminRole === 'editor';
        $('#delete').hidden = adminRole !== 'owner';
        await Promise.all([refreshList(), loadAuthors(), adminRole === 'owner' ? refreshApiKeys() : Promise.resolve()]);
        const requestedArticleId = new URLSearchParams(location.search).get('article');
        if (requestedArticleId) await loadArticle(requestedArticleId);
        const seoBrief = localStorage.getItem('cc-seo-brief');
        if (seoBrief) {
          try {
            const suggestion = JSON.parse(seoBrief);
            $('#brief-title').value = suggestion.title || '';
            $('#brief-content').value = suggestion.brief || '';
            $('#brief-keywords').value = suggestion.keyword || '';
            $('#writing-assistant').open = true;
            localStorage.removeItem('cc-seo-brief');
          } catch (_) { localStorage.removeItem('cc-seo-brief'); }
        }
      } catch (error) { $('#auth-panel').hidden = false; $('#admin-panel').hidden = true; status(error.message, true, '#auth-status'); }
    }

    $('#auth-form').addEventListener('submit', async (event) => { event.preventDefault(); status('Connexion…', false, '#auth-status'); const result = await supabase.auth.signInWithPassword({ email: $('#auth-email').value, password: $('#auth-password').value }); if (result.error) status(authErrorMessage(result.error), true, '#auth-status'); else enterAdmin(); });
    $('#magic-link').addEventListener('click', async () => {
      const email = $('#auth-email').value.trim();
      if (!email) return status('Indiquez votre e-mail.', true, '#auth-status');
      const button = $('#magic-link'); button.disabled = true;
      status('Envoi du lien magique…', false, '#auth-status');
      const result = await supabase.auth.signInWithOtp({ email, options: { emailRedirectTo: adminUrl } });
      if (result.error) {
        if (isEmailRateLimit(result.error)) startEmailCooldown(button); else button.disabled = false;
        status(authErrorMessage(result.error), true, '#auth-status');
      } else {
        startEmailCooldown(button);
        status('Lien de connexion envoyé. Consultez votre boîte de réception et vos courriers indésirables.', false, '#auth-status');
      }
    });
    $('#forgot-password').addEventListener('click', async () => {
      const email = $('#auth-email').value.trim();
      if (!email) return status('Indiquez d’abord votre adresse e-mail.', true, '#auth-status');
      const button = $('#forgot-password'); button.disabled = true;
      status('Envoi du lien de récupération…', false, '#auth-status');
      const result = await supabase.auth.resetPasswordForEmail(email, { redirectTo: recoveryUrl });
      if (result.error) {
        if (isEmailRateLimit(result.error)) startEmailCooldown(button); else button.disabled = false;
        status(authErrorMessage(result.error), true, '#auth-status');
      } else {
        startEmailCooldown(button);
        status('Si ce compte existe, un lien de récupération vient d’être envoyé. Consultez également vos courriers indésirables.', false, '#auth-status');
      }
    });
    $('#recovery-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const password = $('#new-password').value;
      const confirmation = $('#confirm-password').value;
      if (password.length < 12) return status('Le mot de passe doit contenir au moins 12 caractères.', true, '#recovery-status');
      if (password !== confirmation) return status('Les deux mots de passe ne correspondent pas.', true, '#recovery-status');
      const button = $('#save-password'); button.disabled = true;
      status('Enregistrement sécurisé…', false, '#recovery-status');
      const result = await supabase.auth.updateUser({ password });
      button.disabled = false;
      if (result.error) return status(authErrorMessage(result.error), true, '#recovery-status');
      history.replaceState({}, '', '/admin');
      $('#recovery-form').reset(); $('#recovery-panel').hidden = true;
      status('Mot de passe modifié. Ouverture de l’administration…', false, '#auth-status');
      await enterAdmin();
    });
    $('#cancel-recovery').addEventListener('click', async () => { await supabase.auth.signOut(); location.assign('/admin'); });
    $('#sign-out').addEventListener('click', async () => { await supabase.auth.signOut(); location.reload(); });
    $('#article-form').addEventListener('submit', saveDraft);
    $('#new-article').addEventListener('click', () => { resetEditor(); $('#writing-assistant').open = true; $('#brief-title').focus(); });
    $('#refresh-list').addEventListener('click', refreshList);
    $('#sidebar-search').addEventListener('input', renderSidebar);
    document.querySelectorAll('[data-sidebar-status]').forEach((button) => button.addEventListener('click', () => {
      sidebarStatus = button.dataset.sidebarStatus;
      document.querySelectorAll('[data-sidebar-status]').forEach((item) => item.classList.toggle('is-active', item === button));
      renderSidebar();
    }));
    let lastSidebarRefresh = 0;
    window.addEventListener('focus', () => {
      if (!$('#admin-panel').hidden && Date.now() - lastSidebarRefresh > 2_000) {
        lastSidebarRefresh = Date.now();
        refreshList();
      }
    });
    $('#prepare-draft').addEventListener('click', prepareDraft);
    $('#clear-brief').addEventListener('click', () => { $('#brief-title').value = ''; $('#brief-content').value = ''; $('#brief-keywords').value = ''; $('#brief-sources').value = ''; $('#brief-source-error').hidden = true; });
    document.querySelectorAll('.source-preset').forEach((button) => button.addEventListener('click', () => addSourcePreset(button)));
    $('#format').addEventListener('change', updateFormat); $('#preview').addEventListener('click', previewArticle); $('#publish').addEventListener('click', publishArticle);
    document.querySelectorAll('input[name="assistant-mode"]').forEach((input) => input.addEventListener('change', () => {
      const improving = input.checked && input.value === 'improve';
      if (improving && !$('#article-id').value) status('Sélectionnez un article dans la barre latérale, puis indiquez vos consignes.', false, '#assistant-status');
