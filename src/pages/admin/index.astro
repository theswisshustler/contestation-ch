      .forEach((id) => $(`#${id}`).addEventListener('input', updateThemePreview));
    const recoveryRequested = new URLSearchParams(location.search).get('mode') === 'recovery';
    supabase.auth.onAuthStateChange((event, nextSession) => {
      session = nextSession;
      if (event === 'PASSWORD_RECOVERY') showRecovery();
    });
    const initial = await supabase.auth.getSession();
    session = initial.data.session;
    const authParams = new URLSearchParams(location.search);
    const authErrorCode = authParams.get('error_code');
    const authError = authParams.get('error');
    if (recoveryRequested) showRecovery(session ? '' : 'Ce lien est invalide ou a expiré. Demandez un nouveau lien depuis la page de connexion.');
    else if (session) enterAdmin();
    else if (authError || authErrorCode) {
      status(authErrorCode === 'otp_expired'
        ? 'Ce lien de connexion a expiré ou a déjà été utilisé. Demandez un nouveau lien magique.'
        : 'Le lien de connexion est invalide. Demandez un nouveau lien magique.', true, '#auth-status');
      history.replaceState({}, '', '/admin');
    }
